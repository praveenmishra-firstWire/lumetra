{%- comment -%}
  Renders the variant picker, quantity selector, and buy buttons.
  Expects: product, section, current_variant
{%- endcomment -%}

<product-form
  class="fp-form"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
>
  <script type="application/json" data-product-json>
    {{ product.variants | json }}
  </script>

  {%- form 'product', product, novalidate: 'novalidate', class: 'fp-form__form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

    {%- if section.settings.show_variant_picker and product.has_only_default_variant == false -%}
      <div class="fp-variant-groups">
        {%- for option in product.options_with_values -%}
          <div class="fp-variant-picker" data-option-index="{{ forloop.index0 }}">
            <span class="fp-variant-picker__label" id="OptionLabel-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</span>

            {%- if section.settings.variant_style == 'dropdown' -%}
              <select
                class="fp-variant-select"
                aria-labelledby="OptionLabel-{{ section.id }}-{{ forloop.index0 }}"
                data-option-index="{{ forloop.index0 }}"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if value == current_variant.options[forloop.parentloop.index0] %}selected{% endif %}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            {%- else -%}
              <div
                class="fp-variant-picker__options{% if section.settings.variant_style == 'swatch' %} fp-variant-picker__options--swatch{% endif %}"
                role="radiogroup"
                aria-labelledby="OptionLabel-{{ section.id }}-{{ forloop.index0 }}"
              >
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="fp-variant-btn{% if section.settings.variant_style == 'swatch' %} fp-variant-btn--swatch{% endif %}{% if value == current_variant.options[forloop.parentloop.index0] %} is-selected{% endif %}"
                    role="radio"
                    aria-checked="{% if value == current_variant.options[forloop.parentloop.index0] %}true{% else %}false{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <p class="fp-availability" data-availability-message aria-live="polite">
      {%- unless current_variant.available -%}Sold out{%- endunless -%}
    </p>

    {%- if section.settings.show_quantity_selector -%}
      <div class="fp-quantity">
        <span class="fp-quantity__label" id="QtyLabel-{{ section.id }}">Quantity</span>
        <div class="fp-quantity__stepper">
          <button type="button" aria-label="Decrease quantity" data-quantity-decrease>−</button>
          <input
            type="number"
            name="quantity"
            value="1"
            min="1"
            {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' %}
              max="{{ current_variant.inventory_quantity }}"
            {% endif %}
            aria-labelledby="QtyLabel-{{ section.id }}"
            data-quantity-input
          >
          <button type="button" aria-label="Increase quantity" data-quantity-increase>+</button>
        </div>
      </div>
    {%- endif -%}

    <div class="fp-buttons">
      <button
        type="submit"
        name="add"
        class="fp-btn fp-btn--primary"
        data-add-to-cart-button
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span data-add-to-cart-label>
          {%- if current_variant.available -%}
            {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
      </button>

      {%- if section.settings.show_buy_now -%}
        <button
          type="submit"
          name="checkout"
          class="fp-btn fp-btn--secondary"
          data-buy-now-button
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {{ section.settings.buy_now_label | default: 'Buy it now' }}
        </button>
      {%- endif -%}
    </div>

    <p class="fp-form__error" data-form-error role="alert" hidden></p>
  {%- endform -%}
</product-form>
