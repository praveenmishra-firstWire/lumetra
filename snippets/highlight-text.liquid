{%- doc -%}
  Renders rich text with an optional inline highlight effect applied to
  any phrase the merchant has italicized in the editor.

  To highlight a phrase, the merchant selects it in the rich text toolbar
  and clicks Italic — that phrase is then styled per `style`, and the
  italics themselves are removed (the visual effect replaces them).

  @param {string} text - raw HTML from a richtext/inline_richtext setting
  @param {boolean} enabled - whether highlighting is turned on
  @param {string} style - one of: marker, circle, underline, bold-underline,
    modern-underline, sketch-underline, squiggle, heavy-squiggle, solid-color
  @param {string} color - CSS color used for the highlight effect
{%- enddoc -%}

{%- if enabled and text != blank and style != blank -%}
  {%- assign open_tag = '<mark class="highlight-text" data-style="' | append: style | append: '" style="--highlight-color: ' | append: color | append: ';">' -%}
  {{- text | replace: '<em>', open_tag | replace: '</em>', '</mark>' -}}
{%- else -%}
  {{- text -}}
{%- endif -%}

{% stylesheet %}
.highlight-text {
  font-style: normal;
  color: inherit;
  background: none;
}

.highlight-text[data-style="marker"] {
  background-image: linear-gradient(
    120deg,
    color-mix(in srgb, var(--highlight-color, #ffd43b) 45%, transparent) 0%,
    color-mix(in srgb, var(--highlight-color, #ffd43b) 45%, transparent) 100%
  );
  background-repeat: no-repeat;
  background-size: 100% 0.5em;
  background-position: 0 78%;
  box-decoration-break: clone;
}

.highlight-text[data-style="solid-color"] {
  background-color: var(--highlight-color, #ffd43b);
  box-decoration-break: clone;
  padding: 0.02em 0.15em;
}

.highlight-text[data-style="circle"] {
  display: inline;
  border: 2px solid var(--highlight-color, #ffd43b);
  border-radius: 50em;
  padding: 0.05em 0.5em;
  box-decoration-break: clone;
}

.highlight-text[data-style="underline"] {
  text-decoration: underline;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

.highlight-text[data-style="bold-underline"] {
  text-decoration: underline;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 4px;
  text-underline-offset: 4px;
}

.highlight-text[data-style="modern-underline"] {
  text-decoration: underline;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 3px;
  text-underline-offset: 7px;
}

.highlight-text[data-style="sketch-underline"] {
  text-decoration: underline wavy;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 1.5px;
  text-underline-offset: 3px;
}

.highlight-text[data-style="squiggle"] {
  text-decoration: underline wavy;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 2.5px;
  text-underline-offset: 4px;
}

.highlight-text[data-style="heavy-squiggle"] {
  text-decoration: underline wavy;
  text-decoration-color: var(--highlight-color, #ffd43b);
  text-decoration-thickness: 4px;
  text-underline-offset: 5px;
}
{% endstylesheet %}
