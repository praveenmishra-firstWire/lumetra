    },
    {
      "type": "color",
      "id": "badge_new_color",
      "label": "Label badge color",
      "default": "#1a56db"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Quick add / Add to cart button color",
      "default": "#12203f"
    },
    {
      "type": "color",
      "id": "button_icon_color",
