      "options": [
        { "value": "amount_saved", "label": "Amount saved (e.g. Save $10)" },
        { "value": "percent_off", "label": "Percent off (e.g. -20%)" }
      ],
      "default": "amount_saved"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show product labels",
      "info": "Reads a 'new' tag, or a custom tag formatted as label:YourText",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add to Cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show Quick Look / Quick View",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
