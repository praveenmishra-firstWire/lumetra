{{ 'scrolling-promotion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sp_id = section.id
  assign sp_speed = section.settings.speed | default: 60
  assign sp_gap = section.settings.gap | default: 40
-%}

{%- comment -%}
  Icon sprite: a simplified line-icon set covering the picker list below.
  Merchants who want pixel-exact artwork for a specific icon can paste their
  own markup into a block's "Custom SVG icon" field, which always takes
  priority over this sprite.
{%- endcomment -%}
<svg style="display:none" aria-hidden="true">
