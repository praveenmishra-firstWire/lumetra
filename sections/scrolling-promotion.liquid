</svg>

<div
  class="scrolling-promo{% if section.settings.direction == 'right' %} scrolling-promo--right{% endif %}{% if section.settings.pause_on_hover %} scrolling-promo--pause-hover{% endif %}"
  id="scrolling-promo-{{ sp_id }}"
  style="
    --sp-bg: {{ section.settings.color_background }};
    --sp-text: {{ section.settings.color_text }};
    --sp-icon: {{ section.settings.color_icon }};
    --sp-gap: {{ sp_gap }}px;
    --sp-padding-top: {{ section.settings.padding_top }}px;
    --sp-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-scrolling-promo
  data-speed="{{ sp_speed }}"
>
  <div class="scrolling-promo__viewport">
    <div class="scrolling-promo__track" data-scrolling-promo-track>
      {%- for i in (1..2) -%}
        <div
          class="scrolling-promo__set"
          {% if i == 2 %}
            aria-hidden="true"
          {% endif %}
        >
          {%- for block in section.blocks -%}
            {%- assign sp_has_link = false -%}
            {%- if block.settings.link != blank -%}
              {%- assign sp_has_link = true -%}
            {%- endif -%}

            {%- case block.type -%}
              {%- when 'announcement' -%}
                {%- if sp_has_link -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="scrolling-promo__item"
                    {% if i == 1 %}
                      {{ block.shopify_attributes -}}
                    {% endif %}
                  >
                {%- else -%}
                  <div
                    class="scrolling-promo__item"
                    {% if i == 1 %}
                      {{ block.shopify_attributes -}}
                    {% endif %}
                  >
                {%- endif -%}

                {%- if block.settings.custom_svg_icon != blank -%}
                  <span class="scrolling-promo__icon scrolling-promo__icon--{{ block.settings.icon_size }}">
                    {{- block.settings.custom_svg_icon -}}
                  </span>
                {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
                  <span class="scrolling-promo__icon scrolling-promo__icon--{{ block.settings.icon_size }}">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <use href="#sp-icon-{{ block.settings.icon }}" xlink:href="#sp-icon-{{ block.settings.icon }}"></use>
                    </svg>
                  </span>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <span
                    class="scrolling-promo__text"
                    style="font-size: {{ block.settings.text_size | default: 20 }}px;"
                  >
                    {{- block.settings.text -}}
                  </span>
                {%- endif -%}

                {%- if sp_has_link -%}</a>{%- else -%}</div>{%- endif -%}

              {%- when 'image' -%}
                {%- liquid
                  assign sp_height = block.settings.custom_height | default: 80
                -%}
                {%- if sp_has_link -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="scrolling-promo__item scrolling-promo__item--image"
                    {% if i == 1 %}
                      {{ block.shopify_attributes -}}
                    {% endif %}
                  >
                {%- else -%}
                  <div
                    class="scrolling-promo__item scrolling-promo__item--image"
                    {% if i == 1 %}
                      {{ block.shopify_attributes -}}
                    {% endif %}
                  >
                {%- endif -%}

                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    style="height: {{ sp_height }}px;"
                    class="scrolling-promo__image"
                  >
                {%- else -%}
                  <div class="scrolling-promo__placeholder-wrapper" style="height: {{ sp_height }}px; width: {{ sp_height }}px;">
                    {{ 'image' | placeholder_svg_tag: 'scrolling-promo__placeholder-svg' }}
                  </div>
                {%- endif -%}

                {%- if sp_has_link -%}</a>{%- else -%}</div>{%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'scrolling-text.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Scrolling promotion",
  "tag": "section",
  "class": "section-scrolling-promotion",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 20,
      "max": 200,
      "step": 10,
      "unit": "s",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 8,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#1A1A1A" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#FFFFFF" },
    {
      "type": "color",
      "id": "color_icon",
      "label": "Icon color",
      "info": "Only applies to the preset icon picker, not custom SVG icons.",
      "default": "#FFFFFF"
    },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "apple", "label": "Apple" },
            { "value": "banana", "label": "Banana" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "carrot", "label": "Carrot" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "dolly", "label": "Dolly" },
            { "value": "download", "label": "Download" },
            { "value": "dryer", "label": "Dryer" },
            { "value": "eye", "label": "Eye" },
            { "value": "fire", "label": "Fire" },
            { "value": "globe", "label": "Globe" },
            { "value": "gluten_free", "label": "Gluten free" },
            { "value": "headset", "label": "Headset" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "light", "label": "Light" },
            { "value": "lightning_bolt", "label": "Lightning bolt" },
            { "value": "link", "label": "Link" },
            { "value": "lock", "label": "Lock" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "music", "label": "Music" },
            { "value": "package", "label": "Package" },
            { "value": "paw_print", "label": "Paw print" },
            { "value": "pepper", "label": "Pepper" },
            { "value": "phone", "label": "Phone" },
            { "value": "plane", "label": "Plane" },
            { "value": "plant", "label": "Plant" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "question_mark", "label": "Question mark" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "return_icon", "label": "Return" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "shield", "label": "Shield" },
            { "value": "ship", "label": "Ship" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "icon_size",
          "label": "Icon size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        },
        {
          "type": "html",
          "id": "custom_svg_icon",
          "label": "Custom SVG icon",
          "info": "Overrides the icon above when filled in. [Learn more about SVG](https://developer.mozilla.org/en-US/docs/Web/SVG)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Text size",
          "min": 12,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 20
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "custom_height",
          "label": "Custom height",
          "min": 20,
          "max": 200,
          "step": 4,
          "unit": "px",
          "default": 80
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling promotion",
      "category": "Text",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
