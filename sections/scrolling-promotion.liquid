  <symbol id="sp-icon-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15.5 0 18M12 3c-2.5 2.5-2.5 15.5 0 18"/></symbol>
  <symbol id="sp-icon-gluten_free" viewBox="0 0 24 24"><path d="M6 18c2-8 4-12 6-14 2 2 4 6 6 14"/><path d="M3 21 21 3"/></symbol>
