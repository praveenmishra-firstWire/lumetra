  <symbol id="sp-icon-phone" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></symbol>
  <symbol id="sp-icon-plane" viewBox="0 0 24 24"><path d="M3 13l18-8-8 18-2-8-8-2Z"/></symbol>
