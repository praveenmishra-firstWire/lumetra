{%- comment -%}
  ============================================================================
    COLLECTION collage SHOWCASE
    Asymmetric "collage grid" of navigational tiles: one large tile (image or
    uploaded video) spanning two rows on the left, two smaller tiles top
    right, and one wide tile bottom right — each linking out to a product,
    collection, or custom URL, with a title and optional status dot overlay.

    Shopify Online Store 2.0 compatible. CSS/JS live in separate asset files;
    only the per-instance custom-property values stay inline here.

    NOTE ON TYPOGRAPHY: intentionally no font-family is set anywhere in this
    section's CSS. Font size, weight, letter-spacing and color are exposed as
    settings, but the typeface itself is left to inherit from the theme's
    own global font settings, so changing the font in the Theme Editor's
    typography settings is never fought by this section.
  ============================================================================
{%- endcomment -%}

{{ 'collection-collage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign sec_id = section.id
-%}

<section
  id="Collectioncollage-{{ sec_id }}"
  class="cbs"
  data-collection-collage
  data-full-width="{{ s.full_width }}"
  data-hover-zoom="{{ s.enable_hover_zoom }}"
>
  <div class="cbs__inner">
    {%- if s.heading != blank -%}
      <h2 class="cbs__heading">{{ s.heading }}</h2>
    {%- endif -%}

    <div class="cbs__grid" data-cbs-grid>
      {%- assign small_tile_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'large_tile' -%}
            {%- assign bs = block.settings -%}
            <div class="cbs__tile cbs__tile--large" data-cbs-tile {{ block.shopify_attributes }}>
              <a href="{{ bs.link | default: '#' }}" class="cbs__tile-link" aria-label="{{ bs.title | escape }}">
                {%- if bs.media_type == 'video' and bs.video != blank -%}
                  <video
                    class="cbs__media cbs__media--video"
                    data-cbs-video
                    {% if bs.video_autoplay %}
                      autoplay
                    {% endif %}
                    {% if bs.video_loop %}
                      loop
                    {% endif %}
                    {% if bs.video_muted %}
                      muted
                    {% endif %}
                    {% unless bs.show_controls %}
                      playsinline
                    {% endunless %}
                    {% if bs.show_controls %}
                      controls
                    {% endif %}
                    preload="metadata"
                    {% if bs.image != blank %}
                      poster="{{ bs.image | image_url: width: 1200 }}"
                    {% endif %}
                  >
                    {%- for source in bs.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- elsif bs.image != blank -%}
                  <img
                    class="cbs__media"
                    src="{{ bs.image | image_url: width: 900 }}"
                    srcset="{{ bs.image | image_url: width: 500 }} 500w, {{ bs.image | image_url: width: 900 }} 900w, {{ bs.image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 990px) 45vw, 100vw"
                    alt="{{ bs.image.alt | default: bs.title | escape }}"
                    loading="lazy"
                    width="{{ bs.image.width }}"
                    height="{{ bs.image.height }}"
                  >
                {%- else -%}
                  <div class="cbs__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'cbs__placeholder-svg' }}</div>
                {%- endif -%}

                <div class="cbs__overlay" aria-hidden="true"></div>

                <div class="cbs__content">
                  {%- if bs.title != blank -%}
                    <span class="cbs__title">{{ bs.title }}</span>
                  {%- endif -%}
                  {%- if bs.show_badge_dot -%}<span class="cbs__badge-dot" aria-hidden="true"></span>{%- endif -%}
                </div>
              </a>
            </div>

          {%- when 'tile' -%}
            {%- assign small_tile_index = small_tile_index | plus: 1 -%}
            {%- assign bs = block.settings -%}
            <div class="cbs__tile cbs__tile--{{ small_tile_index }}" data-cbs-tile {{ block.shopify_attributes }}>
              <a href="{{ bs.link | default: '#' }}" class="cbs__tile-link" aria-label="{{ bs.title | escape }}">
                {%- if bs.image != blank -%}
                  <img
                    class="cbs__media"
                    src="{{ bs.image | image_url: width: 700 }}"
                    srcset="{{ bs.image | image_url: width: 400 }} 400w, {{ bs.image | image_url: width: 700 }} 700w, {{ bs.image | image_url: width: 1000 }} 1000w"
                    sizes="(min-width: 990px) 25vw, 100vw"
                    alt="{{ bs.image.alt | default: bs.title | escape }}"
                    loading="lazy"
                    width="{{ bs.image.width }}"
                    height="{{ bs.image.height }}"
                  >
                {%- else -%}
                  <div class="cbs__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'cbs__placeholder-svg' }}</div>
                {%- endif -%}

                <div class="cbs__overlay" aria-hidden="true"></div>

                <div class="cbs__content">
                  {%- if bs.title != blank -%}
                    <span class="cbs__title">{{ bs.title }}</span>
                  {%- endif -%}
                  {%- if bs.show_badge_dot -%}<span class="cbs__badge-dot" aria-hidden="true"></span>{%- endif -%}
                </div>
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- style -%}
  #Collectioncollage-{{ sec_id }} {
    --cbs-bg: {{ s.background_color }};
    --cbs-heading-color: {{ s.heading_color }};
    --cbs-gap: {{ s.grid_gap }}px;
    --cbs-mobile-gap: {{ s.grid_gap | times: 0.7 | round }}px;
    --cbs-radius: {{ s.tile_border_radius }}px;
    --cbs-overlay-color: {{ s.overlay_color }};
    --cbs-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --cbs-title-color: {{ s.title_color }};
    --cbs-title-size: {{ s.title_font_size }}px;
    --cbs-title-weight: {{ s.title_font_weight }};
    --cbs-badge-color: {{ s.badge_dot_color }};
    --cbs-badge-size: {{ s.badge_dot_size }}px;
    --cbs-grid-height: {{ s.grid_height_desktop }}px;
    --cbs-mobile-aspect-ratio: {{ s.mobile_tile_aspect_ratio }};
    --cbs-padding-top: {{ s.padding_top }}px;
    --cbs-padding-bottom: {{ s.padding_bottom }}px;
  }
{%- endstyle -%}

<script src="{{ 'collection-collage.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection collage",
  "tag": "section",
  "class": "section section--collection-collage",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "info": "Breaks the section out of the theme's content container so its background spans the full browser width edge-to-edge. Content inside still stays readable at a max-width.",
      "default": true
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "tile_border_radius",
      "label": "Tile corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "grid_height_desktop",
      "label": "Grid height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "mobile_tile_aspect_ratio",
      "label": "Tile aspect ratio (mobile, stacked)",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Widescreen" }
      ],
      "default": "4/3"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Zoom media on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay gradient color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Tile Title & Badge"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title font weight",
      "info": "Weight only — the typeface itself always follows your theme's font settings",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "badge_dot_color",
      "label": "Status dot color",
      "default": "#3ecf4a"
    },
    {
      "type": "range",
      "id": "badge_dot_size",
      "label": "Status dot size",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "large_tile",
      "name": "Large Tile",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used when Media type is Image, and as the video's poster/fallback frame"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Used when Media type is Video"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_muted",
          "label": "Mute video",
          "info": "Most browsers block autoplay entirely unless muted is on",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_controls",
          "label": "Show video controls",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Featured Collection"
        },
        {
          "type": "checkbox",
          "id": "show_badge_dot",
          "label": "Show status dot",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "The first 3 Tile blocks fill the top-right, top-right, and bottom-wide positions. Additional Tile blocks beyond 3 won't have a slot in this layout."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection"
        },
        {
          "type": "checkbox",
          "id": "show_badge_dot",
          "label": "Show status dot",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection collage",
      "blocks": [
        { "type": "large_tile", "settings": { "title": "MG20 Gaming Headphones", "show_badge_dot": true } },
        { "type": "tile", "settings": { "title": "MW08 Sport" } },
        { "type": "tile", "settings": { "title": "Accessories" } },
        { "type": "tile", "settings": { "title": "MH40 Wireless" } }
      ],
      "category": "Collections"
    }
  ]
}
{% endschema %}
