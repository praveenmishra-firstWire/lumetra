{{ 'featured-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = section.settings.product

  case section.settings.color_scheme
    when 'light'
      assign bg_color = '#ffffff'
      assign heading_color = '#1a1a1a'
      assign text_color = '#4a4a4a'
      assign price_color = '#1a1a1a'
      assign accent_color = '#16332a'
    when 'dark'
      assign bg_color = '#16332a'
      assign heading_color = '#ffffff'
      assign text_color = '#dbe5d5'
      assign price_color = '#ffffff'
      assign accent_color = '#c9dcc0'
    else
      assign bg_color = section.settings.background_color
      assign heading_color = section.settings.heading_color
      assign text_color = section.settings.text_color
      assign price_color = section.settings.price_color
      assign accent_color = section.settings.accent_color
  endcase
-%}

{%- style -%}
  #FeaturedProduct-{{ section.id }} {
    --fp-bg: {{ bg_color }};
    --fp-heading-color: {{ heading_color }};
    --fp-text-color: {{ text_color }};
    --fp-price-color: {{ price_color }};
    --fp-accent-color: {{ accent_color }};
    --fp-button-radius: {{ section.settings.button_corner_radius }}px;
    --fp-image-width: {{ section.settings.image_width_desktop }}%;
    --fp-padding-top: {{ section.settings.padding_top }}px;
    --fp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fp-content-gap: {{ section.settings.content_gap }}px;
  }
{%- endstyle -%}

<div
  id="FeaturedProduct-{{ section.id }}"
  class="featured-product{% if section.settings.button_style == 'outline' %} featured-product--outline-buttons{% endif %}"
>
  {%- if featured_product == blank -%}
    {%- if request.design_mode -%}
      <div class="featured-product__placeholder">
        <p>Select a product to feature using the section settings.</p>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="featured-product__inner">
      {%- if section.settings.section_heading != blank or section.settings.subheading != blank -%}
        <div class="featured-product__header">
          {%- if section.settings.subheading != blank -%}
            <p class="fp-overline">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.section_heading != blank -%}
            <h2 class="fp-section-heading">{{ section.settings.section_heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="featured-product__columns">
        {%- if section.settings.show_image -%}
          {%- render 'featured-product-media', product: featured_product, section: section -%}
        {%- endif -%}
        {%- render 'featured-product-info', product: featured_product, section: section -%}
      </div>

      {%- if section.settings.enable_badges and section.blocks.size > 0 -%}
        <div class="fp-badges">
          {%- content_for 'blocks' -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.enable_sticky_cart -%}
      <div class="fp-sticky-bar" data-sticky-bar hidden>
        <div class="fp-sticky-bar__info">
          <span class="fp-sticky-bar__title">{{ featured_product.title }}</span>
          <span class="fp-sticky-bar__price">
            {{- featured_product.selected_or_first_available_variant.price | money -}}
          </span>
        </div>
        <button type="button" class="fp-btn fp-btn--primary" data-sticky-add-to-cart>
          {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
        </button>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<script src="{{ 'nfeatured-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured product",
  "class": "shopify-section--featured-product",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Custom description",
      "info": "Leave blank to use the product's own description."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product type",
      "default": true
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show product thumbnails",
      "default": true
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "rounded", "label": "Rounded" }
      ],
      "default": "rounded"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Image width on large screens",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "Requires a product review app that writes to the reviews.rating metafield.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings_badge",
      "label": "Show savings badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "header",
      "content": "Variants and options"
    },
    {
      "type": "checkbox",
      "id": "show_variant_picker",
      "label": "Show variant picker",
      "default": true
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Variant style",
      "options": [
        { "value": "dropdown", "label": "Dropdown" },
        { "value": "button", "label": "Button" },
        { "value": "swatch", "label": "Swatch" }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_cart",
      "label": "Enable sticky add to cart on small screens",
      "default": true
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show buy it now button",
      "default": true
    },
    {
      "type": "text",
      "id": "buy_now_label",
      "label": "Buy it now button label",
      "default": "Buy it now",
      "visible_if": "{{ section.settings.show_buy_now }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "filled"
    },
    {
      "type": "range",
      "id": "button_corner_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "checkbox",
      "id": "enable_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#1a1a1a",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (buttons)",
      "default": "#16332a",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between image and content",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [{ "type": "trust-badge", "name": "Trust badge", "limit": 4 }],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        { "type": "trust-badge" },
        { "type": "trust-badge" },
        { "type": "trust-badge" },
        { "type": "trust-badge" }
      ]
    }
  ]
}
{% endschema %}
