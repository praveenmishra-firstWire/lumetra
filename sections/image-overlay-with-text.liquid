{{ 'image-overlay-with-text.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.image
%}

<section
  id="ImageOverlay-{{ section.id }}"
  class="premium-overlay"
  style="
    --section-height: {{ section.settings.section_height }}px;
    --overlay-width: {{ section.settings.overlay_width }}%;
    --overlay-bg: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-max-width: {{ section.settings.content_width }}px;
    --desktop-padding: {{ section.settings.desktop_padding }}px;
    --mobile-padding: {{ section.settings.mobile_padding }}px;
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_bg }};
    --button-color: {{ section.settings.button_color }};
    --button-hover-bg: {{ section.settings.button_hover_bg }};
    --button-hover-color: {{ section.settings.button_hover_color }};
    --border-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="premium-overlay__inner{% if section.settings.mobile_layout == 'text_first' %} premium-overlay__inner--mobile-reverse{% endif %}">
    <div class="premium-overlay__media">
      {% if image != blank %}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            sizes: '100vw',
            widths: '600,900,1200,1600,2000,2400',
            class: 'premium-overlay__image'
        }}

      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div
      class="
        premium-overlay__content
        premium-overlay__content--{{ section.settings.overlay_position }}
        premium-overlay__content--{{ section.settings.vertical_alignment }}
        premium-overlay__content--mobile-{{ section.settings.mobile_text_alignment }}
      "
    >
      <div class="premium-overlay__box">
        {% if section.settings.subheading != blank %}
          <div class="premium-overlay__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="premium-overlay__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="premium-overlay__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          {%- capture button_svg -%}<svg viewBox="0 0 24 24" fill="none" width="18" height="18"><path d="M5 12H19" stroke="currentColor" stroke-width="1.5"/><path d="M13 6L19 12L13 18" stroke="currentColor" stroke-width="1.5"/></svg>{%- endcapture -%}

          {%- if section.settings.button_link != blank -%}
            <a href="{{ section.settings.button_link }}" class="premium-overlay__button"
              ><span>{{ section.settings.button_label }}</span>{{ button_svg -}}
            </a>
          {%- else -%}
            <a role="link" aria-disabled="true" class="premium-overlay__button"
              ><span>{{ section.settings.button_label }}</span>{{ button_svg -}}
            </a>
          {%- endif -%}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'image-overlay-with-text.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Image Overlay with text",
  "tag": "section",
  "class": "section-premium-overlay",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text overlay"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Add a short description that encourages customers to explore your collection.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "default": "middle",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },

    {
      "type": "range",
      "id": "overlay_width",
      "label": "Overlay width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 500,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 700
    },

    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 350,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 520
    },

    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop padding",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },

    {
      "type": "header",
      "content": "Mobile layout"
    },

    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile order",
      "info": "Controls whether the image or the content appears first on mobile and tablet.",
      "default": "image_first",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Content first"
        }
      ]
    },

    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile content alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile padding",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "header",
      "content": "Overlay"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },

    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },

    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "button_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#333333"
    },

    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover text",
      "default": "#FFFFFF"
    }
  ],

  "presets": [
    {
      "name": "Image Overlay with text",
      "category": "Images"
    }
  ]
}
{% endschema %}
