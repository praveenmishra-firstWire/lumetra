{{ 'video.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #banner-video-{{ section.id }} {
    --placeholder-bg-1: {{ section.settings.placeholder_bg_1 | default: '#090a0f' }};
    --placeholder-bg-2: {{ section.settings.placeholder_bg_2 | default: '#121526' }};
    --placeholder-accent: {{ section.settings.placeholder_accent | default: '#6366f1' }};
    --placeholder-accent-2: {{ section.settings.placeholder_accent_2 | default: '#ec4899' }};
    --glass-opacity: {{ section.settings.glass_opacity | default: 15 | divided_by: 100.0 }};
    --glass-border-opacity: {{ section.settings.glass_border_opacity | default: 25 | divided_by: 100.0 }};
    --glass-radius: {{ section.settings.glass_radius | default: 16 }}px;
    --anim-speed-factor: {{ section.settings.anim_speed | default: 1.0 }};
    --glow-intensity: {{ section.settings.glow_intensity | default: 50 | divided_by: 100.0 }};
    --overlay-color: {{ section.settings.overlay_color | default: '#000000' }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --content-position: {{ section.settings.content_position | default: 'center' }};
    {% if section.settings.height_mode == '600' or section.settings.height_mode == '750' or section.settings.height_mode == '850' or section.settings.height_mode == '1000' %}
      --section-height: {{ section.settings.height_mode }}px;
    {% endif %}
  }

  /* 3D Cinematic Placeholder Styles */
  .banner-video__placeholder-cinematic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, var(--placeholder-bg-2), var(--placeholder-bg-1));
    overflow: hidden;
    perspective: 1200px;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Animated Mesh Gradient Orbs */
  .cinematic-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: {{ section.settings.mesh_opacity | default: 70 | divided_by: 100.0 }};
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    mix-blend-mode: screen;
    will-change: transform;
  }

  .mesh-orb--1 {
    width: 50vw;
    height: 50vw;
    top: -10vw;
    left: -10vw;
    background: radial-gradient(circle, var(--placeholder-accent), transparent 70%);
    animation: orbFloat1 calc(22s / var(--anim-speed-factor)) ease-in-out infinite alternate;
  }

  .mesh-orb--2 {
    width: 45vw;
    height: 45vw;
    bottom: -10vw;
    right: -5vw;
    background: radial-gradient(circle, var(--placeholder-accent-2), transparent 70%);
    animation: orbFloat2 calc(28s / var(--anim-speed-factor)) ease-in-out infinite alternate;
  }

  .mesh-orb--3 {
    width: 35vw;
    height: 35vw;
    top: 30%;
    left: 40%;
    background: radial-gradient(circle, #3b82f6, transparent 70%);
    animation: orbFloat3 calc(19s / var(--anim-speed-factor)) ease-in-out infinite alternate;
  }

  @keyframes orbFloat1 {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(15vw, 10vh, 0) scale(1.2); }
  }
  @keyframes orbFloat2 {
    0% { transform: translate3d(0, 0, 0) scale(1.1); }
    100% { transform: translate3d(-12vw, -15vh, 0) scale(0.9); }
  }
  @keyframes orbFloat3 {
    0% { transform: translate3d(0, 0, 0) scale(0.9); }
    100% { transform: translate3d(-10vw, 12vh, 0) scale(1.3); }
  }

  /* 3D World Stage */
  .cinematic-stage {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Layers & Drift Track */
  .cinematic-track {
    position: absolute;
    inset: 0;
    width: 200%;
    height: 100%;
    display: flex;
    transform-style: preserve-3d;
    animation: trackDrift calc(35s / var(--anim-speed-factor)) linear infinite;
  }

  @keyframes trackDrift {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Depth Layers */
  .c-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .c-layer--1 { transform: translateZ(120px) scale(0.9); }
  .c-layer--2 { transform: translateZ(60px) scale(0.95); }
  .c-layer--3 { transform: translateZ(0px) scale(1); }
  .c-layer--4 { transform: translateZ(-80px) scale(1.05); filter: blur(2px); }
  .c-layer--5 { transform: translateZ(-160px) scale(1.1); filter: blur(5px); }

  /* Floating Object General Styles */
  .c-obj {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  /* Glass Cards */
  .glass-card {
    background: rgba(255, 255, 255, var(--glass-opacity));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, var(--glass-border-opacity));
    border-radius: var(--glass-radius);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    padding: 14px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
  }

  .card-thumb {
    width: 100%;
    height: 110px;
    border-radius: calc(var(--glass-radius) - 4px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(0, 0, 0, 0.4));
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-thumb__play {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .card-thumb__play svg {
    width: 14px;
    height: 14px;
    fill: #ffffff;
    margin-left: 2px;
  }

  .card-timeline {
    position: absolute;
    bottom: 8px;
    left: 8px;
    right: 8px;
    height: 3px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .card-timeline__bar {
    height: 100%;
    width: 45%;
    background: var(--placeholder-accent);
    border-radius: 2px;
  }

  .card-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 9px;
    font-family: monospace;
    letter-spacing: 0.5px;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-line {
    height: 6px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }
  .card-line--short { width: 60%; }
  .card-line--long { width: 85%; }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
  }

  .card-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(45deg, var(--placeholder-accent), var(--placeholder-accent-2));
  }

  .card-dots {
    display: flex;
    gap: 4px;
  }

  .card-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
  }

  /* Camera & Film Elements */
  .c-svg-icon {
    stroke: rgba(255, 255, 255, 0.4);
    fill: none;
    stroke-width: 1.5;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.3));
  }

  /* Floating Rings & Wireframes */
  .c-ring {
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
  }

  .c-wireframe {
    border: 1.5px stroke rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  /* Timeline Bars & Audio Wave */
  .c-audio-wave {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, var(--glass-opacity));
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, var(--glass-border-opacity));
    border-radius: 20px;
  }

  .wave-bar {
    width: 3px;
    background: var(--placeholder-accent);
    border-radius: 2px;
    animation: waveBounce 1.4s ease-in-out infinite alternate;
  }

  @keyframes waveBounce {
    0% { height: 6px; }
    100% { height: 22px; }
  }

  /* Particles & Glow Dust */
  .c-particle {
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 10px var(--placeholder-accent);
    opacity: 0.6;
    animation: pulseParticle 3s ease-in-out infinite alternate;
  }

  @keyframes pulseParticle {
    0% { opacity: 0.3; transform: scale(0.8); }
    100% { opacity: 0.9; transform: scale(1.3); }
  }

  /* Center Glass Hero Play Button */
  .cinematic-hero-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(180px);
    z-index: 10;
    width: {{ section.settings.play_button_size | default: 110 }}px;
    height: {{ section.settings.play_button_size | default: 110 }}px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), inset 0 2px 4px rgba(255, 255, 255, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }

  {% if section.settings.enable_pulse %}
  .cinematic-hero-play::after {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    animation: playRipple 3s ease-out infinite;
    pointer-events: none;
  }
  {% endif %}

  @keyframes playRipple {
    0% { transform: scale(0.9); opacity: 0.8; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .cinematic-hero-play:hover {
    transform: translate(-50%, -50%) translateZ(220px) scale(1.1);
    box-shadow: 0 40px 80px rgba(99, 102, 241, 0.4), inset 0 2px 6px rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.8);
  }

  .cinematic-hero-play svg {
    width: 36%;
    height: 36%;
    fill: #ffffff;
    margin-left: 6%;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  }

  /* Responsive Object Density */
  @media screen and (max-width: 989px) {
    .cinematic-hero-play {
      width: 90px;
      height: 90px;
    }
    .c-layer--4, .c-layer--5 {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .cinematic-hero-play {
      width: 72px;
      height: 72px;
    }
    .c-layer--3 {
      display: none;
    }
  }

  /* Reduced Motion Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .cinematic-track, .mesh-orb, .wave-bar, .c-particle, .cinematic-hero-play::after {
      animation: none !important;
    }
  }
{%- endstyle -%}

<div
  class="banner-video banner-video--{{ section.settings.height_mode }}"
  id="banner-video-{{ section.id }}"
>
  <div class="banner-video__media">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          image_size: '1920x',
          autoplay: section.settings.autoplay,
          loop: section.settings.loop,
          muted: section.settings.mute,
          controls: section.settings.show_controls,
          class: 'banner-video__el'
      }}
    {% elsif section.settings.video_url != blank %}
      <video
        class="banner-video__el"
        {% if section.settings.poster %}
          poster="{{ section.settings.poster | image_url: width: 1920 }}"
        {% endif %}
        {% if section.settings.autoplay %}
          autoplay muted playsinline
        {% endif %}
        {% if section.settings.loop %}
          loop
        {% endif %}
        {% if section.settings.show_controls %}
          controls
        {% endif %}
        {% unless section.settings.mute %}
        {% else %}
          muted
        {% endunless %}
        preload="metadata"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.poster %}
      {{
        section.settings.poster
        | image_url: width: 1920
        | image_tag: class: 'banner-video__el banner-video__el--image', widths: '750,1100,1500,1920'
      }}
    {% else %}
      <!-- 3D Cinematic Animated Video Placeholder -->
      <div class="banner-video__placeholder-cinematic" data-cinematic-placeholder>
        <!-- Animated Mesh Light Orbs -->
        {% if section.settings.enable_blobs %}
          <div class="cinematic-mesh">
            <div class="mesh-orb mesh-orb--1"></div>
            <div class="mesh-orb mesh-orb--2"></div>
            <div class="mesh-orb mesh-orb--3"></div>
          </div>
        {% endif %}

        <!-- 3D Parallax Stage -->
        <div class="cinematic-stage" data-cinematic-stage>
          <div class="cinematic-track">
            <!-- LAYER 1 (Closest Foreground Hero Glass Cards) -->
            <div class="c-layer c-layer--1">
              <!-- Hero Card 1 -->
              <div class="c-obj glass-card" style="left: 5%; top: 15%; width: 220px; transform: rotate(-4deg);">
                <div class="card-thumb">
                  <div class="card-thumb__play">
                    <svg viewBox="0 0 24 24">
                      <polygon points="8,5 19,12 8,19"/>
                    </svg>
                  </div>
                  <div class="card-badge">4K ULTRA</div>
                  <div class="card-timeline"><div class="card-timeline__bar"></div></div>
                </div>
                <div class="card-info">
                  <div class="card-line card-line--long"></div>
                  <div class="card-line card-line--short"></div>
                  <div class="card-meta">
                    <div class="card-avatar"></div>
                    <div class="card-dots">
                      <div class="card-dot"></div>
                      <div class="card-dot"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Hero Card 2 (Track loop dup) -->
              <div class="c-obj glass-card" style="left: 55%; top: 55%; width: 210px; transform: rotate(5deg);">
                <div class="card-thumb">
                  <div class="card-thumb__play">
                    <svg viewBox="0 0 24 24">
                      <polygon points="8,5 19,12 8,19"/>
                    </svg>
                  </div>
                  <div class="card-badge">02:45</div>
                  <div class="card-timeline"><div class="card-timeline__bar" style="width: 70%;"></div></div>
                </div>
                <div class="card-info">
                  <div class="card-line card-line--long"></div>
                  <div class="card-line card-line--short"></div>
                </div>
              </div>

              <!-- Floating Audio Wave Bar -->
              {% if section.settings.enable_timeline_cards %}
                <div class="c-obj c-audio-wave" style="left: 35%; top: 25%; transform: rotate(2deg);">
                  <div class="wave-bar" style="animation-delay: 0s;"></div>
                  <div class="wave-bar" style="animation-delay: 0.2s;"></div>
                  <div class="wave-bar" style="animation-delay: 0.4s;"></div>
                  <div class="wave-bar" style="animation-delay: 0.1s;"></div>
                  <div class="wave-bar" style="animation-delay: 0.5s;"></div>
                  <span style="font-size: 10px; color: rgba(255,255,255,0.7); font-family: monospace; margin-left: 6px;"
                    >00:14 / 03:20</span
                  >
                </div>
              {% endif %}
            </div>

            <!-- LAYER 2 (Mid-Foreground Cards & Film Frames) -->
            <div class="c-layer c-layer--2">
              <div class="c-obj glass-card" style="left: 28%; top: 58%; width: 190px; transform: rotate(-6deg);">
                <div class="card-thumb" style="height: 90px;">
                  <div class="card-thumb__play">
                    <svg viewBox="0 0 24 24">
                      <polygon points="8,5 19,12 8,19"/>
                    </svg>
                  </div>
                </div>
                <div class="card-info">
                  <div class="card-line card-line--long"></div>
                </div>
              </div>

              <div class="c-obj glass-card" style="left: 78%; top: 18%; width: 200px; transform: rotate(3deg);">
                <div class="card-thumb" style="height: 95px;">
                  <div class="card-badge">REC ●</div>
                </div>
                <div class="card-info">
                  <div class="card-line card-line--short"></div>
                </div>
              </div>

              <!-- Film Frame SVG -->
              <svg class="c-obj c-svg-icon" style="left: 18%; top: 72%; width: 60px; height: 60px;" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="4"/>
                <line x1="7" y1="2" x2="7" y2="22"/>
                <line x1="17" y1="2" x2="17" y2="22"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
              </svg>
            </div>

            <!-- LAYER 3 (Midground Camera Icons & Abstract UI) -->
            <div class="c-layer c-layer--3">
              <!-- Camera Icon -->
              <svg
                class="c-obj c-svg-icon"
                style="left: 45%; top: 68%; width: 70px; height: 70px; transform: rotate(-12deg);"
                viewBox="0 0 24 24"
              >
                <path d="M23 7l-7 5 7 5V7z"/>
                <rect x="1" y="5" width="15" height="14" rx="3"/>
              </svg>

              <!-- Connection Lines -->
              <svg
                class="c-obj"
                style="left: 12%; top: 38%; width: 240px; height: 80px; opacity: 0.3;"
                viewBox="0 0 240 80"
              >
                <path d="M0,40 Q60,0 120,40 T240,40" fill="none" stroke="var(--placeholder-accent)" stroke-width="2" stroke-dasharray="4 4"/>
              </svg>

              <!-- Floating Ring -->
              {% if section.settings.enable_rings %}
                <div class="c-obj c-ring" style="left: 62%; top: 12%; width: 90px; height: 90px;"></div>
              {% endif %}
            </div>

            <!-- LAYER 4 (Deep Background Wireframes & Dust Particles) -->
            <div class="c-layer c-layer--4">
              <div
                class="c-obj c-wireframe"
                style="left: 8%; top: 8%; width: 140px; height: 140px; transform: rotate(15deg);"
              ></div>
              <div
                class="c-obj c-wireframe"
                style="left: 52%; top: 40%; width: 180px; height: 120px; transform: rotate(-8deg);"
              ></div>

              {% if section.settings.enable_particles %}
                <div class="c-obj c-particle" style="left: 22%; top: 18%; width: 8px; height: 8px;"></div>
                <div class="c-obj c-particle" style="left: 48%; top: 82%; width: 6px; height: 6px;"></div>
                <div class="c-obj c-particle" style="left: 72%; top: 32%; width: 10px; height: 10px;"></div>
                <div class="c-obj c-particle" style="left: 88%; top: 75%; width: 7px; height: 7px;"></div>
              {% endif %}
            </div>

            <!-- LAYER 5 (Furthest Background Glow Orbs) -->
            <div class="c-layer c-layer--5">
              <div class="c-obj c-ring" style="left: 30%; top: 75%; width: 160px; height: 160px; opacity: 0.15;"></div>
              <div class="c-obj c-ring" style="left: 80%; top: 50%; width: 200px; height: 200px; opacity: 0.1;"></div>
            </div>
          </div>
        </div>

        <!-- Center Glass Hero Play Button -->
        <div class="cinematic-hero-play" aria-label="Play Video Preview" role="button" tabindex="0">
          <svg viewBox="0 0 24 24">
            <polygon points="8,5 19,12 8,19"/>
          </svg>
        </div>
      </div>
    {% endif %}
    <div class="banner-video__overlay"></div>
  </div>

  {% if section.settings.heading != blank
    or section.settings.subheading != blank
    or section.settings.button_label != blank
  %}
    <div class="banner-video__content">
      {% if section.settings.subheading != blank %}
        <p class="banner-video__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="banner-video__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="banner-video__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="banner-video__button">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.video != blank and section.settings.show_sound_toggle %}
    <button type="button" class="banner-video__sound-toggle" aria-label="Toggle sound" data-sound-toggle>
      <svg class="icon-sound-on" viewBox="0 0 24 24" width="20" height="20">
        <path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3zm13.5 2a4.5 4.5 0 0 0-2.5-4.03v8.05a4.5 4.5 0 0 0 2.5-4.02zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/>
      </svg>
      <svg class="icon-sound-off" viewBox="0 0 24 24" width="20" height="20" style="display:none">
        <path fill="currentColor" d="M16.5 12c0-1.77-1-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.94 8.94 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4l-1.88 1.88L12 7.76V4z"/>
      </svg>
    </button>
  {% endif %}
</div>

<script src="{{ 'video.js' | asset_url }}" defer="defer"></script>

<script>
  (function() {
    const placeholder = document.querySelector('#banner-video-{{ section.id }} [data-cinematic-placeholder]');
    if (!placeholder) return;

    const stage = placeholder.querySelector('[data-cinematic-stage]');
    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;
    let isHovered = false;

    {% if section.settings.enable_mouse_parallax %}
    // Mouse Parallax Effect (Desktop)
    if (window.matchMedia('(pointer: fine)').matches) {
      placeholder.addEventListener('mousemove', (e) => {
        const rect = placeholder.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        targetX = ((e.clientX - centerX) / (rect.width / 2)) * {{ section.settings.parallax_intensity | default: 20 }};
        targetY = ((e.clientY - centerY) / (rect.height / 2)) * {{ section.settings.parallax_intensity | default: 20 }};
        isHovered = true;
      });

      placeholder.addEventListener('mouseleave', () => {
        targetX = 0;
        targetY = 0;
        isHovered = false;
      });

      function animateParallax() {
        mouseX += (targetX - mouseX) * 0.08;
        mouseY += (targetY - mouseY) * 0.08;

        if (stage) {
          stage.style.transform = `rotateY(${mouseX * 0.4}deg) rotateX(${-mouseY * 0.4}deg) translate3d(${mouseX}px, ${mouseY}px, 0)`;
        }
        requestAnimationFrame(animateParallax);
      }
      animateParallax();
    }
    {% endif %}

    // IntersectionObserver to pause track animation when out of view
    const track = placeholder.querySelector('.cinematic-track');
    if (track && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            track.style.animationPlayState = 'running';
          } else {
            track.style.animationPlayState = 'paused';
          }
        });
      }, { threshold: 0.1 });
      observer.observe(placeholder);
    }
  })();
</script>

