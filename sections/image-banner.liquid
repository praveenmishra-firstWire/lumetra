        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position on small screens",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
