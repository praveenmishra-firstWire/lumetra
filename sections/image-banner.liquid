{{ 'image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.min_height_unit
    when 'vh'
      assign min_height = section.settings.min_height_vh | append: 'vh'
    else
      assign min_height = section.settings.min_height_px | append: 'px'
  endcase

  assign has_primary_button = false
  if section.settings.primary_button_label != blank
    assign has_primary_button = true
  endif

  assign has_secondary_button = false
  if section.settings.secondary_button_label != blank
    assign has_secondary_button = true
  endif
-%}

{%- style -%}
  #ImageBanner-{{ section.id }} {
    --ib-min-height: {{ min_height }};
    --ib-overlay-color: {{ section.settings.overlay_color }};
    --ib-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ib-max-content-width: {{ section.settings.max_content_width }}px;
    --ib-heading-font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --ib-heading-font-style: {{ section.settings.heading_font.style }};
    --ib-heading-weight: {{ section.settings.heading_weight }};
    --ib-heading-size: {{ section.settings.heading_size }}px;
    --ib-heading-color: {{ section.settings.heading_color }};
    --ib-text-font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    --ib-text-size: {{ section.settings.text_size }}px;
    --ib-text-color: {{ section.settings.text_color }};
    --ib-primary-button-bg: {{ section.settings.primary_button_color }};
    --ib-primary-button-text: {{ section.settings.primary_button_text_color }};
    --ib-secondary-button-bg: {{ section.settings.secondary_button_color }};
    --ib-secondary-button-text: {{ section.settings.secondary_button_text_color }};
    --ib-button-radius: {{ section.settings.button_corner_radius }}px;
    --ib-badge-bg: {{ section.settings.badge_background }};
    --ib-badge-text: {{ section.settings.badge_text_color }};
    --ib-section-padding-top: {{ section.settings.padding_top }}px;
    --ib-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ib-content-padding-top-desktop: {{ section.settings.content_padding_top_desktop }}px;
    --ib-content-padding-right-desktop: {{ section.settings.content_padding_right_desktop }}px;
    --ib-content-padding-bottom-desktop: {{ section.settings.content_padding_bottom_desktop }}px;
    --ib-content-padding-left-desktop: {{ section.settings.content_padding_left_desktop }}px;
    --ib-content-padding-top-mobile: {{ section.settings.content_padding_top_mobile }}px;
    --ib-content-padding-right-mobile: {{ section.settings.content_padding_right_mobile }}px;
    --ib-content-padding-bottom-mobile: {{ section.settings.content_padding_bottom_mobile }}px;
    --ib-content-padding-left-mobile: {{ section.settings.content_padding_left_mobile }}px;
  }
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ section.settings.text_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

<div
  id="ImageBanner-{{ section.id }}"
  class="image-banner{% if section.settings.hide_on_mobile %} image-banner--hide-mobile{% endif %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  data-content-width="{{ section.settings.content_width }}"
  data-animate="{{ section.settings.animate_content }}"
>
  <div class="image-banner__media">
    {%- if section.settings.image != blank -%}
      <img
        class="image-banner__image image-banner__image--{{ section.settings.image_behavior }}"
        srcset="
          {{ section.settings.image | image_url: width: 400 }} 400w,
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2560 }} 2560w
        "
        sizes="100vw"
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
        fetchpriority="{% if section.index == 1 %}high{% else %}auto{% endif %}"
        decoding="async"
        style="object-position: {{ section.settings.image_position }};"
      >
    {%- else -%}
      <div class="image-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'image-banner__placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="image-banner__overlay"></div>
  </div>

  {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
    <div
      class="image-banner__badge image-banner__badge--{{ section.settings.badge_style }}"
      data-badge-position="{{ section.settings.badge_position }}"
      style="--badge-offset-top: {{ section.settings.badge_offset_top }}px; --badge-offset-bottom: {{ section.settings.badge_offset_bottom }}px;"
    >
      {%- if section.settings.badge_icon != blank -%}
        <span class="image-banner__badge-icon">
          {%- render 'icons-with-text-icon', icon: section.settings.badge_icon -%}
        </span>
      {%- endif -%}
      <span class="image-banner__badge-text">{{ section.settings.badge_text }}</span>
    </div>
  {%- endif -%}

  <div
    class="image-banner__content"
    data-position="{{ section.settings.content_position_desktop }}"
    data-valign="{{ section.settings.vertical_alignment_desktop }}"
    data-mobile-position="{{ section.settings.content_position_mobile }}"
  >
    <div class="image-banner__box{% if section.settings.show_border %} image-banner__box--bordered{% endif %}">
      {%- if section.settings.show_close_button -%}
        <button type="button" class="image-banner__close" aria-label="Dismiss" data-dismiss-banner>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="image-banner__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="image-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="image-banner__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if has_primary_button or has_secondary_button -%}
        <div class="image-banner__buttons">
          {%- if has_primary_button -%}
            <a
              href="{{ section.settings.primary_button_link | default: '#' }}"
              class="image-banner__btn image-banner__btn--primary{% if section.settings.primary_button_style == 'outline' %} image-banner__btn--outline{% endif %}"
              {% if section.settings.primary_button_link == blank %}role="link" aria-disabled="true"{% endif %}
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}
          {%- if has_secondary_button -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="image-banner__btn image-banner__btn--secondary{% if section.settings.secondary_button_style == 'outline' %} image-banner__btn--outline{% endif %}"
              {% if section.settings.secondary_button_link == blank %}role="link" aria-disabled="true"{% endif %}
            >
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'image-banner.js' | asset_url }}" defer="defer"></script>

{% schema %}
