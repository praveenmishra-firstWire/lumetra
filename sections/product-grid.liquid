    },
    {
      "type": "text",
      "id": "custom_badge_1_tag",
      "label": "Custom badge 1 tag"
    },
    {
      "type": "checkbox",
      "id": "custom_badge_2_enable",
      "label": "Enable custom badge 2",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_badge_2_text",
      "label": "Custom badge 2 text",
      "default": "Staff Pick"
    },
    {
      "type": "text",
      "id": "custom_badge_2_tag",
      "label": "Custom badge 2 tag"
    },
    {
      "type": "header",
      "content": "Buttons and actions"
    },
    {
      "type": "select",
      "id": "add_to_cart_style",
      "label": "Add to cart style",
      "options": [
        { "value": "button", "label": "Button" },
        { "value": "icon", "label": "Icon" },
        { "value": "quick_add", "label": "Quick add on hover" }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show quick view",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_view_label",
      "label": "Quick view label",
      "default": "Quick view"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_icon",
