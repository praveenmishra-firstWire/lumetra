{{ 'product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source_collection = section.settings.collection
  assign products = source_collection.products | default: empty
  assign product_limit = section.settings.products_to_show

  if section.settings.view_all_link_type == 'custom'
    assign view_all_url = section.settings.view_all_custom_link
  else
    assign view_all_url = source_collection.url
  endif
-%}

{%- style -%}
  #ProductGrid-{{ section.id }} {
    --pg-columns-desktop: {{ section.settings.columns_desktop }};
    --pg-columns-tablet: {{ section.settings.columns_tablet }};
    --pg-columns-mobile: {{ section.settings.columns_mobile }};
    --pg-grid-gap: {{ section.settings.grid_gap }}px;
    --pg-image-radius: {{ section.settings.image_radius }}px;
    --pg-price-color: {{ section.settings.price_color }};
    --pg-sale-price-color: {{ section.settings.sale_price_color }};
    --pg-badge-color: {{ section.settings.badge_color }};
    --pg-badge-text-color: {{ section.settings.badge_text_color }};
    --pg-button-color: {{ section.settings.button_color }};
    --pg-button-text-color: {{ section.settings.button_text_color }};
    --pg-background: {{ section.settings.background_color }};
    --pg-card-background: {{ section.settings.card_background_color }};
    --pg-heading-color: {{ section.settings.heading_color }};
    --pg-text-color: {{ section.settings.text_color }};
    --pg-padding-top: {{ section.settings.padding_top }}px;
    --pg-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div
  id="ProductGrid-{{ section.id }}"
  class="product-grid{% if section.settings.enable_on_mobile == false %} product-grid--hide-mobile{% endif %}{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}"
  data-image-ratio="{{ section.settings.image_ratio }}"
  data-image-shape="{{ section.settings.image_shape }}"
  data-image-hover="{{ section.settings.image_hover_effect }}"
  data-animate="{{ section.settings.animation_on_scroll }}"
>
  <div class="product-grid__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="product-grid__header product-grid__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="product-grid__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.show_divider -%}
          <div class="product-grid__divider product-grid__divider--{{ section.settings.divider_style }}"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <div class="product-grid__grid">
        {%- for product in products limit: product_limit -%}
          {%- render 'product-grid-card', product: product, section: section -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="product-grid__placeholder-message">
          <p>Select a collection to display products.</p>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
      <div class="product-grid__view-all">
        <a href="{{ view_all_url }}" class="product-grid__view-all-btn">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<div class="product-grid-quick-view" data-quick-view-modal hidden>
  <div class="product-grid-quick-view__backdrop" data-quick-view-close></div>
  <div class="product-grid-quick-view__panel" role="dialog" aria-modal="true" aria-label="Quick view">
    <button type="button" class="product-grid-quick-view__close" data-quick-view-close aria-label="Close quick view">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        width="18"
        height="18"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6 6 18"/>
      </svg>
    </button>
    <div class="product-grid-quick-view__media">
      <img data-quick-view-image alt="">
    </div>
    <div class="product-grid-quick-view__info">
      <h3 data-quick-view-title></h3>
      <div class="product-grid-quick-view__price">
        <span data-quick-view-price></span>
        <span data-quick-view-compare-price hidden></span>
      </div>
      <div class="product-grid-quick-view__description" data-quick-view-description></div>
      <a class="product-grid-quick-view__link" data-quick-view-link href="#">View full details</a>
    </div>
  </div>
</div>

<script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product grid",
  "class": "shopify-section--product-grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Plants"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bring nature into your home with our handpicked collection."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider under heading",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" button label",
      "default": "View all products"
    },
    {
      "type": "select",
      "id": "view_all_link_type",
      "label": "\"View all\" button link",
      "options": [
        { "value": "collection", "label": "Selected collection" },
        { "value": "custom", "label": "Custom link" }
      ],
      "default": "collection"
    },
    {
      "type": "url",
      "id": "view_all_custom_link",
      "label": "Custom link",
      "info": "Only used when the link above is set to Custom link."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on large screens",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablets",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on small screens",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between products",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "original", "label": "Original" }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square corners" },
        { "value": "rounded", "label": "Rounded corners" }
      ],
      "default": "rounded"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "info": "Only applies when image shape is rounded.",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "image_hover_effect",
      "label": "Image hover effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "zoom", "label": "Zoom" },
        { "value": "lift", "label": "Lift" }
      ],
      "default": "zoom"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_length_limit",
      "label": "Title word limit",
      "info": "0 means no limit.",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "Requires a product review app that writes to the reviews.rating metafield.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_review_count",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "Show new badge",
      "default": true
    },
    {
      "type": "text",
      "id": "new_badge_text",
      "label": "New badge text",
      "default": "New"
    },
    {
