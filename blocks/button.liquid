{%- doc -%}
  Renders a button/link. Reusable across any section that opts in to
  theme blocks (e.g. via {% content_for 'blocks' %}). Visual style (fill
  vs. outline, colors, corner radius) is intentionally left to the parent
  section's CSS variables, so the same button block looks native wherever
  it's dropped.
{%- enddoc -%}

{%- if block.settings.label != blank -%}
  <a
    href="{{ block.settings.link | default: '#' }}"
    class="button-block"
    {% if block.settings.link == blank %}role="link" aria-disabled="true"{% endif %}
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label }}
    {%- if block.settings.show_arrow -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    {%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
