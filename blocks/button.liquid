{%- liquid
  assign style_class = 'button--' | append: block.settings.style
  assign size_class = ''
  if block.settings.size != 'medium'
    assign size_class = 'button--' | append: block.settings.size
  endif
  assign target = ''
  assign rel = ''
  if block.settings.open_in_new_tab
    assign target = '_blank'
    assign rel = 'noopener noreferrer'
  endif
-%}

<a
  href="{{ block.settings.link | default: '#' }}"
  class="button {{ style_class }} {{ size_class }}"
  {% if target != '' %}target="{{ target }}" rel="{{ rel }}"{% endif %}
  {% if block.settings.link == blank %}role="link" aria-disabled="true"{% endif %}
  {{ block.shopify_attributes }}
>
  {{ block.settings.label }}
</a>

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary (solid)" },
        { "value": "secondary", "label": "Secondary (outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    }
  ],
  "presets": [
    { "name": "Button" }
  ]
}
{% endschema %}
