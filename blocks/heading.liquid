{%- doc -%}
  Renders a heading. Reusable across any section that opts in to theme
  blocks (e.g. via {% content_for 'blocks' %}).

  To highlight part of the heading, turn on "Highlight part of the text"
  below, then select a phrase in the text field and click Italic — that
  phrase gets the chosen highlight style instead of italics.
{%- enddoc -%}

{%- if block.settings.text != blank -%}
  <h2
    class="heading-block"
    style="--heading-block-size: {{ block.settings.size }}px;"
    {{ block.shopify_attributes }}
  >
    {%- render 'highlight-text',
      text: block.settings.text,
      enabled: block.settings.enable_highlight,
      style: block.settings.highlight_style,
      color: block.settings.highlight_color
    -%}
  </h2>
{%- endif -%}

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Beautiful plants for a better life"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Highlight"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight",
      "label": "Highlight part of the text",
      "info": "Select a phrase above and click Italic to mark it as the highlighted part.",
      "default": false
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Highlight style",
      "options": [
        { "value": "marker", "label": "Marker" },
        { "value": "circle", "label": "Circle" },
        { "value": "underline", "label": "Underline" },
        { "value": "bold-underline", "label": "Bold underline" },
        { "value": "modern-underline", "label": "Modern underline" },
        { "value": "sketch-underline", "label": "Sketch underline" },
        { "value": "squiggle", "label": "Squiggle" },
        { "value": "heavy-squiggle", "label": "Heavy squiggle" },
        { "value": "solid-color", "label": "Solid color" }
      ],
      "default": "marker"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#ffd43b"
    }
  ],
  "presets": [
    {
      "name": "Heading"
    }
  ]
}
{% endschema %}
