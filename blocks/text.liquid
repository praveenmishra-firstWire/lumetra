{%- doc -%}
  Renders a block of rich text. Reusable across any section that opts in
  to theme blocks (e.g. via {% content_for 'blocks' %}).

  To highlight part of the text, turn on "Highlight part of the text"
  below, then select a phrase and click Italic — that phrase gets the
  chosen highlight style instead of italics.
{%- enddoc -%}

{%- if block.settings.text != blank -%}
  <div class="text-block" {{ block.shopify_attributes }}>
    {%- render 'highlight-text',
      text: block.settings.text,
      enabled: block.settings.enable_highlight,
      style: block.settings.highlight_style,
      color: block.settings.highlight_color
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Transform your space into a green oasis with our handpicked indoor plants that purify the air and lift your mood.</p>"
    },
    {
      "type": "header",
      "content": "Highlight"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight",
      "label": "Highlight part of the text",
      "info": "Select a phrase above and click Italic to mark it as the highlighted part.",
      "default": false
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Highlight style",
      "options": [
        { "value": "marker", "label": "Marker" },
        { "value": "circle", "label": "Circle" },
        { "value": "underline", "label": "Underline" },
        { "value": "bold-underline", "label": "Bold underline" },
        { "value": "modern-underline", "label": "Modern underline" },
        { "value": "sketch-underline", "label": "Sketch underline" },
        { "value": "squiggle", "label": "Squiggle" },
        { "value": "heavy-squiggle", "label": "Heavy squiggle" },
        { "value": "solid-color", "label": "Solid color" }
      ],
      "default": "marker"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#ffd43b"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
