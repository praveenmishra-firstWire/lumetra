{%- doc -%}
  Renders a small icon + label + caption "trust badge" (e.g. Free shipping,
  Secure checkout). Reusable across any section that opts in to theme
  blocks. Shares the icon library with the Icons with text section.
{%- enddoc -%}

{%- if block.settings.heading != blank -%}
  <div class="trust-badge-block" {{ block.shopify_attributes }}>
    <span class="trust-badge-block__icon">
      {%- render 'icons-with-text-icon', icon: block.settings.icon -%}
    </span>
    <span class="trust-badge-block__text">
      <strong>{{ block.settings.heading }}</strong>
      {%- if block.settings.caption != blank -%}
        <span>{{ block.settings.caption }}</span>
      {%- endif -%}
    </span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust badge",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" },
        { "value": "return", "label": "Return" },
        { "value": "lock", "label": "Lock" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "award", "label": "Award" },
        { "value": "headset", "label": "Headset" },
        { "value": "gift", "label": "Gift" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "sun", "label": "Sun" },
        { "value": "box", "label": "Box" },
        { "value": "compass", "label": "Compass" },
        { "value": "thumbs-up", "label": "Thumbs up" },
        { "value": "eye", "label": "Eye" },
        { "value": "person", "label": "Person" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "100% protected"
    }
  ],
  "presets": [
    {
      "name": "Easy to care",
      "settings": { "icon": "leaf", "heading": "Easy to care", "caption": "Beginner friendly" }
    },
    {
      "name": "Free shipping",
      "settings": { "icon": "truck", "heading": "Free shipping", "caption": "On orders over $75" }
    },
    {
      "name": "Secure checkout",
      "settings": { "icon": "shield", "heading": "Secure checkout", "caption": "100% protected" }
    },
    {
      "name": "30-day returns",
      "settings": { "icon": "return", "heading": "30-day returns", "caption": "Hassle free" }
    }
  ]
}
{% endschema %}
